# Whitelist .gitignore — default-deny. Ignore everything at the top level,
# then re-include only the paths that belong in the repo. New/untracked junk
# and the local dev `config/` are therefore never committed by accident.
/*

# Tracked directories
!/.github/
!/.devcontainer/
!/custom_components/
!/docs/
!/scripts/

# Tracked top-level files
!/.gitattributes
!/.gitignore
!/CHANGELOG.md
!/LICENSE
!/README.md
!/hacs.json
!/zensical.en.toml
!/zensical.ko.toml

# Coding-agent scaffolding is deliberately NOT tracked: AGENTS.md (and the
# CLAUDE.md symlink to it), .agents/ (skills, workflows, agents, memory) and
# .claude/ stay local to each working copy. The top-level `/*` rule already
# ignores them - they are listed here only so the intent is explicit and
# nobody re-adds a `!` line for them by accident.
#   /AGENTS.md
#   /CLAUDE.md
#   /.agents/
#   /.claude/

# Noise inside tracked directories
__pycache__/
*.py[cod]
.DS_Store
